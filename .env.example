# Maxio Advanced Billing
MAXIO_API_KEY=
MAXIO_SITE_SUBDOMAIN=your-test-site
MAXIO_ENVIRONMENT=US
MAXIO_DEFAULT_PRODUCT_FAMILY=metermate-consulting

# Slack (bot-token app)
# Required scopes: chat:write, groups:write, users:read.email, groups:read
SLACK_BOT_TOKEN=xoxb-...
SLACK_DIGEST_CHANNEL=

# Demo consultants (emails must be real Slack workspace members for tier-1 channel invites)
CONSULTANT_1_NAME=Consultant One
CONSULTANT_1_EMAIL=
CONSULTANT_2_NAME=Consultant Two
CONSULTANT_2_EMAIL=

# Admin (placeholder auth — Basic credentials for admin-guarded routes)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# App
PORT=4000
SESSION_TTL_MINUTES=30
DEMO_MODE=true
DIGEST_CRON=0 9 * * 1
